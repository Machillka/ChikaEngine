                "--project",
                "${workspaceFolder}/ChikaProject.json",
                "--mode",
                "development",
                "--smoke-frames",
                "3"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "terminal": "integrated",
            "stopOnEntry": false,
            "preLaunchTask": "Build: ChikaGame (Debug)"
        },
