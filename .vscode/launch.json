{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ChikaGame: Interactive",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/bin/ChikaGame",
            "args": [
                "--project",
                "${workspaceFolder}/ChikaProject.json",
                "--mode",
                "development"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "terminal": "integrated",
            "stopOnEntry": false,
            "preLaunchTask": "Build: ChikaGame (Debug)"
        },
        {
            "name": "ChikaGame: 3-frame Smoke",
            "type": "lldb",
            "request": "launch",
